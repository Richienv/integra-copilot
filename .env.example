# Any OpenAI-compatible API. Alibaba Cloud Bailian (Qwen) shown; DeepSeek works the same way.
# Put your key after LLM_API_KEY=. Left empty, the copilot uses ChatGPT through the Codex CLI instead (below).
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Optional: price per million tokens, so evaluation reports can show cost. Empty means 0.
LLM_PRICE_IN=
LLM_PRICE_OUT=
# Optional: extra fields for every request body, as a JSON object (keep the single quotes). A local
# mlx_lm.server running Qwen3, for example (LLM_BASE_URL=http://127.0.0.1:8080/v1), can turn thinking off with:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# Optional: a real Integra database, connecting as copilot_reader (see README, "Against a real Integra database").
COPILOT_DATABASE_URL=
# No API key? Leave LLM_API_KEY empty: with the ChatGPT app installed and signed in, the copilot uses ChatGPT
# through the Codex CLI inside the app instead. To force it and pick the model:
# LLM_BACKEND=codex
# CODEX_MODEL=gpt-6-sol
# CODEX_EFFORT=low
# Evaluation with Codex needs a Codex home without your personal AGENTS.md. Sign in to a separate one yourself,
# with the Codex inside the ChatGPT app (a `codex` on your PATH may be another one; python -m copilot doctor
# prints the exact command for the binary the copilot uses):
#   mkdir -p ~/.codex-eval && CODEX_HOME=~/.codex-eval /Applications/ChatGPT.app/Contents/Resources/codex login
# CODEX_HOME=~/.codex-eval
